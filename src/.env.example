BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
ADMINS=123456789
BOT_NAME=TsuloVPN

SUBSCRIPTION_PUBLIC_URL=https://tsulovpn.onrender.com

UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Узлов внутри каждого АВТО-профиля (WIFI и LTE отдельно)
SUBSCRIPTION_CONFIG_LIMIT=40
AUTO_PROBE_INTERVAL_SEC=12
SUBSCRIPTION_SHOW_INDIVIDUAL=false

# АВТО WIFI — чёрные списки
WIFI_SOURCE_URLS=https://raw.githubusercontent.com/igareck/vpn-configs-for-russia/refs/heads/main/BLACK_VLESS_RUS_mobile.txt
# АВТО LTE — белые списки (через запятую)
LTE_SOURCE_URLS=https://raw.githubusercontent.com/igareck/vpn-configs-for-russia/refs/heads/main/WHITE-CIDR-RU-all.txt,https://raw.githubusercontent.com/igareck/vpn-configs-for-russia/refs/heads/main/WHITE-SNI-RU-all.txt

POOL_REFRESH_INTERVAL=300
HAPP_ENCRYPT_SUBSCRIPTION=true

# Оплата Cardlink (https://cardlink.link)
CARDLINK_API_TOKEN=123|your_api_token_here
CARDLINK_SHOP_ID=G1vrEyX0LR
CARDLINK_PAYMENT_METHOD=SBP

PAYMENTS_ENFORCE=false
