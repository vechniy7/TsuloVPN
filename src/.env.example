# TsuloVPN — env для Amvera

BOT_TOKEN=YOUR_BOT_TOKEN
ADMINS=YOUR_TELEGRAM_ID
BOT_NAME=TsuloVPN

# Публичный HTTPS URL для пользователей / Happ / кабинет / оплаты.
# Через Cloudflare Pages (Amvera origin скрыт — лучше на LTE и с VPN):
SUBSCRIPTION_PUBLIC_URL=https://tsulo-tg-relay.pages.dev
# Прямой Amvera (часто режется мобильными/VPN) — только как origin:
# SUBSCRIPTION_PUBLIC_URL=https://tsulovpn-culoebali.amvera.io
PORT=80

UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# --- VPN источник (основной) ---
VPN_SOURCE_URL=https://webhook.projectcube.tech:8443/YOUR_TOKEN
# Доп. источники. Пусто или "-" = не используется.
VPN_BYPASS_SOURCE_URL=
VPN_BYPASS_SOURCE_URL_2=
BYPASS_CONFIG_LIMIT=25

# Единый профиль Happ для всех источников (iPhone 11 Pro)
SUB_HWID=cdjymarydl3xgyv8
SUB_DEVICE_OS=iOS
SUB_DEVICE_OS_VER=17.7
SUB_DEVICE_MODEL=iPhone12,3
SUB_DEVICE_LOCALE=ru
SUB_FETCH_UA=Happ/5.5.0

# Опрос панелей
POOL_REFRESH_INTERVAL=7200
POOL_REFRESH_JITTER_SEC=1800
POOL_STARTUP_DELAY_SEC=180
SOURCE_FETCH_BACKOFF_SEC=7200
ADMIN_FORCE_REFRESH_COOLDOWN_SEC=3600

# Telegram webhook (Amvera не умеет long polling к api.telegram.org)
TELEGRAM_WEBHOOK_ENABLED=true
TELEGRAM_WEBHOOK_PATH=/telegram/webhook
# Секрет опционален. Если пусто — webhook без проверки заголовка.
# TELEGRAM_WEBHOOK_SECRET=

# Канал
REQUIRED_CHANNEL=@TsuloVPN
REQUIRED_CHANNEL_URL=https://t.me/TsuloVPN
CHANNEL_GATE_ENABLED=true

# Поддержка (username / личка — не группа)
SUPPORT_URL=https://t.me/tsuloew
# SUPPORT_EMAIL=support@example.com
INSTAGRAM_URL=https://www.instagram.com/tsulo.it

# Админ-панель: https://ВАШ-ДОМЕН/panel
# Придумайте длинный пароль и никому не светите
ADMIN_PANEL_TOKEN=change-me-long-secret

# Оплата Platega (ключи из ЛК https://platega.io/ → Настройки)
# Callback URL в кабинете Platega:
#   https://ВАШ-ДОМЕН/platega/webhook
PAYMENTS_ENFORCE=false
PLATEGA_MERCHANT_ID=
PLATEGA_API_KEY=
# Опционально: 2=СБП, 11=карты. Пусто = выбор на странице оплаты.
# PLATEGA_PAYMENT_METHOD=

# --- iOS IKEv2 catalog (опционально; VPN daemon на отдельном VPS) ---
# IKEV2_APP_TOKEN=
# IKEV2_SERVER=
# IKEV2_USERNAME=tsulo
# IKEV2_PASSWORD=
# IKEV2_REMOTE_ID=
# IKEV2_LOCAL_ID=tsulo
