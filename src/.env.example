# TsuloVPN — env для Amvera
# VPN-источники не трогать без необходимости.

BOT_TOKEN=YOUR_BOT_TOKEN
ADMINS=YOUR_TELEGRAM_ID
BOT_NAME=TsuloVPN

SUBSCRIPTION_PUBLIC_URL=https://tsulovpn-culoebali.amvera.io
PORT=80

UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# --- VPN источники (обязательно) ---
VPN_SOURCE_URL=https://nbbsub.mystatic-cdn.ru/YOUR_TOKEN
# Доп. источник (🔥). Пусто или "-" = не используется.
VPN_BYPASS_SOURCE_URL=-
# Второй доп. источник (⚡)
VPN_BYPASS_SOURCE_URL_2=https://webhook.projectcube.tech:8443/YOUR_TOKEN
VPN_BYPASS_SOURCE_URL_2_HWID=your-hwid-from-happ
VPN_BYPASS_SOURCE_URL_2_FETCH_UA=Happ/5.5.0
VPN_BYPASS_SOURCE_URL_2_DEVICE_OS=iOS
VPN_BYPASS_SOURCE_URL_2_DEVICE_OS_VER=17.7
VPN_BYPASS_SOURCE_URL_2_DEVICE_MODEL=iPhone12,3
BYPASS_CONFIG_LIMIT=25

# HWID основной панели
SUB_HWID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SUB_DEVICE_MODEL=SM-S918B
SUB_DEVICE_OS=Android
SUB_DEVICE_OS_VER=14
SUB_DEVICE_LOCALE=ru
SUB_FETCH_UA=Happ/3.5.0

# Опрос панелей
POOL_REFRESH_INTERVAL=7200
POOL_REFRESH_JITTER_SEC=1800
POOL_STARTUP_DELAY_SEC=180
SOURCE_FETCH_BACKOFF_SEC=7200
ADMIN_FORCE_REFRESH_COOLDOWN_SEC=3600

# Прокси для fetch источников
UPSTREAM_PROXY_URL=http://LOGIN:PASS@IP:PORT

# Канал
REQUIRED_CHANNEL=@TsuloVPN
REQUIRED_CHANNEL_URL=https://t.me/TsuloVPN
CHANNEL_GATE_ENABLED=true

# Поддержка (username / личка — не группа)
SUPPORT_URL=https://t.me/tsuloew
# SUPPORT_EMAIL=support@example.com
INSTAGRAM_URL=https://www.instagram.com/tsulo.it

# Добровольные переводы (опционально)
DONATE_CARD=2202209226540747
DONATE_BANK=Сбербанк
# DONATE_CARD_NAME=

# Оплата: оставить false — доступ бесплатный. Включить после Platega.
PAYMENTS_ENFORCE=false
# PLATEGA_MERCHANT_ID=
# PLATEGA_API_KEY=

# --- iOS IKEv2 catalog (опционально; VPN daemon на отдельном VPS) ---
# IKEV2_APP_TOKEN=
# IKEV2_SERVER=
# IKEV2_USERNAME=tsulo
# IKEV2_PASSWORD=
# IKEV2_REMOTE_ID=
# IKEV2_LOCAL_ID=tsulo
