# TsuloVPN — минимальный env для Amvera
# Смена ключа VPN: поменяйте только VPN_SOURCE_URL и пересоберите проект.

BOT_TOKEN=YOUR_BOT_TOKEN
ADMINS=YOUR_TELEGRAM_ID
BOT_NAME=TsuloVPN

SUBSCRIPTION_PUBLIC_URL=https://tsulovpn-culoebali.amvera.io
PORT=80

UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

VPN_SOURCE_URL=https://subs.eu-fffast.com/YOUR_TOKEN

# --- Защита от бана аккаунта у провайдера ---
# Уникальный HWID на каждый бот (PowerShell: [guid]::NewGuid().ToString())
SUB_HWID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
SUB_DEVICE_MODEL=SM-S918B
SUB_DEVICE_OS=Android
SUB_DEVICE_OS_VER=14
SUB_DEVICE_LOCALE=ru

# Опрос панели: 7200 = 2 ч, 14400 = 4 ч
POOL_REFRESH_INTERVAL=7200
POOL_REFRESH_JITTER_SEC=1800
POOL_STARTUP_DELAY_SEC=180
SOURCE_FETCH_BACKOFF_SEC=7200
ADMIN_FORCE_REFRESH_COOLDOWN_SEC=3600

# proxy6.net IPv4 — HTTP или SOCKS5 (оба работают):
UPSTREAM_PROXY_URL=http://LOGIN:PASS@IP:PORT
# UPSTREAM_PROXY_URL=socks5://LOGIN:PASS@IP:PORT

SUPPORT_URL=https://t.me/tsuloew
INSTAGRAM_URL=https://www.instagram.com/tsulo.it
DONATE_CARD=2202209226540747
DONATE_CARD_NAME=АЛИ Ц
DONATE_BANK=Сбербанк
