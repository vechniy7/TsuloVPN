BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
ADMINS=123456789
BOT_NAME=TsuloVPN

SUBSCRIPTION_PUBLIC_URL=https://tsulovpn.onrender.com

UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

SUBSCRIPTION_CONFIG_LIMIT=120
SUBSCRIPTION_SHOW_INDIVIDUAL=false
CONFIG_SOURCE_URL=https://raw.githubusercontent.com/igareck/vpn-configs-for-russia/refs/heads/main/WHITE-CIDR-RU-checked.txt
CONFIG_FILL_SOURCE_URL=https://raw.githubusercontent.com/igareck/vpn-configs-for-russia/refs/heads/main/Vless-Reality-White-Lists-Rus-Mobile.txt
# По умолчанию ещё: WHITE-CIDR-RU-all, WHITE-SNI-RU-all, aviamasters verified.
# (Mobile-2 у igareck удалён — 404)
# CONFIG_SOURCE_URLS=url1,url2,url3
# CONFIG_EXTRA_SOURCE_URLS=urlA,urlB
POOL_REFRESH_INTERVAL=300
HAPP_ENCRYPT_SUBSCRIPTION=true

# Оплата Cardlink (https://cardlink.link)
CARDLINK_API_TOKEN=123|your_api_token_here
CARDLINK_SHOP_ID=G1vrEyX0LR
# SBP или BANK_CARD — оставьте пустым, если клиент выбирает сам
CARDLINK_PAYMENT_METHOD=SBP

# Блокировать доступ без оплаты (авто-вкл при Cardlink)
PAYMENTS_ENFORCE=false
