BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
ADMINS=123456789
BOT_NAME=TsuloVPN

SUBSCRIPTION_PUBLIC_URL=https://tsulovpn-culoebali.amvera.io
# Домен из Amvera: «Настройки → Доменные имена». Не tsulovpn.culoebali (точка) — у него битый SSL.
PORT=80

UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Подписка: прямой HTTPS URL. happ://crypt3/... сюда НЕ вставлять.
# Панели Remnawave / mystatic-cdn требуют SUB_FETCH_UA=Happ/3.5.0 и SUB_HWID.
PRIMARY_SUB_URL=https://nbbsub.mystatic-cdn.ru/YOUR_TOKEN
WIFI_SOURCE_URLS=https://nbbsub.mystatic-cdn.ru/YOUR_TOKEN
LTE_SOURCE_URLS=https://nbbsub.mystatic-cdn.ru/YOUR_TOKEN
# legacy ShadowNet (опционально, если ещё используете):
# SHADOWNET_CONNECT_URL=https://shadow-net.site/connect?token=YOUR_TOKEN

SUBSCRIPTION_CONFIG_LIMIT=50
LTE_CONFIG_LIMIT=50
LTE_BALANCER_NODES=10
LTE_TCP_CHECK=false

WHITELIST_CIDR_URL=https://raw.githubusercontent.com/hxehex/russia-mobile-internet-whitelist/main/cidrwhitelist.txt

KEEP_SOURCE_NAMES=true
SUB_FETCH_UA=Happ/3.5.0
SUB_HWID=TsuloVPN-Server-Render-01
SUB_DEVICE_OS=Linux
SUB_DEVICE_OS_VER=6.1
SUB_DEVICE_MODEL=TsuloVPN-Server

POOL_REFRESH_INTERVAL=300
HAPP_ENCRYPT_SUBSCRIPTION=true
# В боте лучше false: plain https копируется надёжно (crypt5 ~850 символов ломает копирование)
BOT_ENCRYPT_SUBSCRIPTION=false

PAYMENTS_ENFORCE=false

SUPPORT_URL=https://t.me/tsuloew
INSTAGRAM_URL=https://www.instagram.com/tsulo.it
DONATE_CARD=2202209226540747
DONATE_CARD_NAME=АЛИ Ц
DONATE_BANK=Сбербанк
